# ==== 应用配置 ====
APP_NAME=rag-knowledge-base
LOG_LEVEL=INFO

# ==== PostgreSQl（docker-compose 与后端共用）====

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_kb
POSTGRES_PORT=5432

# 后端连接串：注意使用asyncpg driver

DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_kb

# ==== 腾讯云 COS ====
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=

# ===== Embedding（DashScope OpenAI 兼容协议）=====
# 申请 key：https://bailian.console.aliyun.com/ → API-KEY
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
# ===== 文档上传与切分 =====
UPLOAD_MAX_SIZE_MB=50
CHUNK_SIZE=600
CHUNK_OVERLAP=60

CHAT_API_KEY=
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.6
CHAT_HISTORY_WINDOW=5

# ===== Query 优化 =====
# 关掉后强制走 original 路径，便于对比有/无路由的效果
QUERY_ROUTE_ENABLED=true
# Multi-Query 策略生成的子查询数量
MULTI_QUERY_COUNT=3


# ===== Reranker =====
# 关掉后 rerank 节点直接透传，作为有/无精排的对比开关
RERANK_ENABLED=True
RERANK_MODEL=qwen3-rerank
# DashScope rerank 端点，不是标准 OpenAI API
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
# 留空则自动复用 CHAT_API_KEY
RERANK_API_KEY=
# rerank Top1 相关度低于此阈值时拒答（qwen3-rerank score ∈ [0, 1]）
RERANK_MIN_SCORE=0.3
RERANK_TIMEOUT=8.0
# ===== 答案校验 =====
# 关掉后跳过 verify_answer 调用，方便对比有/无引用支撑校验的效果
VERIFY_ANSWER_ENABLED=True


# ===== LangSmith 可观测性 =====
# 关掉后 trace 整链路降级
LANGSMITH_TRACING=False
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-knowledge-base
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 配置后前端会展示「在 LangSmith 中查看」跳转链接，未配置则只显示复制按钮
# 格式：https://smith.langchain.com/o/{org_id}/projects/p/{project_name}
LANGSMITH_RUN_URL_PREFIX=



# ===== 认证 =====
# JWT 签名密钥；生产环境务必改成足够长的随机串
# 生成示例：openssl rand -hex 32
JWT_SECRET=changeme-please-use-a-strong-random-secret
JWT_ALGORITHM=HS256
# token 过期分钟数，默认 24 小时
JWT_EXPIRE_MINUTES=1440
# 首次启动种子管理员：库内无用户时自动创建（已有用户时跳过）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_DISPLAY_NAME=管理员




# ===== Redis =====
REDIS_PORT=6379
# 应用直接客户端：用于语义缓存与滑动窗口限流
REDIS_URL=redis://localhost:6379/0
# Celery broker / backend 各占一个 db，避免与应用缓存键互相干扰
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2



# ===== 语义缓存 =====
# 关掉后 chat 主链路完全跳过缓存查询/写入
SEMANTIC_CACHE_ENABLED=True
# 单条缓存最大存活时间（秒），默认 1 小时
SEMANTIC_CACHE_TTL_SECONDS=3600
# 余弦相似度阈值：query 与缓存问题向量相似度 ≥ 此值且权限范围一致才视为命中
SEMANTIC_CACHE_MIN_SIMILARITY=0.92
# ===== 滑动窗口限流 =====
# 关掉后 enforce_rate_limit dependency 直接放行
RATE_LIMIT_ENABLED=True
# 单用户每分钟最大写请求数（chat / 上传 / 重新索引共用窗口）
RATE_LIMIT_PER_MINUTE=60